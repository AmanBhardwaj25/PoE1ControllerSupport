	"localization"
	{
		"english"
		{
			"title"		"PoE Controller mod (Deck)"
			"description"		"For the PoE Controller mod. Plain gamepad, plus: right trackpad = left stick (mouse-like swipes, no mouse), right trackpad click = A, left trackpad = left stick (mouse-like swipes), L4 = L3 (scouting), R4 = R3 (follow camera), L5 = View+Menu (mod settings). No mouse or keyboard output, so the mod stays in controller mode."
		}
	}
